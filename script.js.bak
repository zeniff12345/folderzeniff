document.addEventListener('DOMContentLoaded', () => {
  const storageKeys = { preferences: 'wayfinder-preferences', route: 'wayfinder-saved-route' };
  const routes = {
    Transit: { time: 28, route: 'Green Line -> Red Line', detail: 'Reliable service with the best pattern match.', condition: 'Light traffic and clear skies.' },
    Drive: { time: 31, route: 'Via Storrow Drive', detail: 'Direct route with light traffic right now.', condition: 'Light traffic, with $4.20 in tolls.' },
    Bike: { time: 36, route: 'Charles River path', detail: 'A clear, scenic route for an active start.', condition: 'Clear route with comfortable conditions.' }
  };
  const trips = [
    { date: 'Tuesday, October 24', origin: 'South End', destination: 'Cambridge', mode: 'Transit', duration: 28, status: 'On time', traffic: 'Light traffic', notes: 'Smooth Green Line connection and a clear arrival window.' },
    { date: 'Monday, October 23', origin: 'South End', destination: 'Cambridge', mode: 'Transit', duration: 30, status: 'On time', traffic: 'Moderate traffic', notes: 'Two-minute platform wait added a little time.' },
    { date: 'Friday, October 20', origin: 'South End', destination: 'Cambridge', mode: 'Bike', duration: 35, status: 'Completed', traffic: 'Clear route', notes: 'Comfortable ride along the Charles River path.' },
    { date: 'Thursday, October 19', origin: 'South End', destination: 'Cambridge', mode: 'Drive', duration: 34, status: 'Delayed', traffic: 'Heavy traffic', notes: 'Storrow Drive slowed near the river crossing.' }
  ];
  const $ = (selector, root = document) => root.querySelector(selector);
  const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];
  const readStorage = (key, fallback) => { try { return JSON.parse(localStorage.getItem(key)) || fallback; } catch { return fallback; } };
  const saveStorage = (key, value) => { try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* File URLs may restrict storage. */ } };
  let preferences = { mode: 'Transit', time: '07:42', avoidTolls: false, notifications: 'on', ...readStorage(storageKeys.preferences, {}) };
  const savedRoute = readStorage(storageKeys.route, {});
  let selectedMode = routes[savedRoute.mode] ? savedRoute.mode : routes[preferences.mode] ? preferences.mode : 'Transit';
  let toastTimer;

  const formatTime = (value) => { const [hour, minute] = value.split(':').map(Number); return `${((hour + 11) % 12) + 1}:${String(minute).padStart(2, '0')} ${hour >= 12 ? 'PM' : 'AM'}`; };
  const formatDate = (date) => new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric' }).format(date);
  const showToast = (message) => { const toast = $('.toast'); toast.textContent = message; toast.classList.add('visible'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.remove('visible'), 2800); };
  const setPopover = (popover, button, open) => { popover.hidden = !open; button.setAttribute('aria-expanded', String(open)); };
  const closePopovers = () => { setPopover($('#profile-menu'), $('.profile-button'), false); setPopover($('#route-menu'), $('.icon-button'), false); };
  const openModal = (id) => { closePopovers(); const backdrop = $(`#${id}`); backdrop.hidden = false; document.body.classList.add('modal-open'); $('.modal-close', backdrop)?.focus(); };
  const closeModal = (backdrop) => { if (!backdrop) return; backdrop.hidden = true; if ($$('.modal-backdrop:not([hidden])').length === 0) document.body.classList.remove('modal-open'); };

  const renderPatterns = () => { $('#patterns-view').innerHTML = `<div class="view-heading"><div><p class="eyebrow">Your commute intelligence</p><h1 id="patterns-title">My patterns<span>.</span></h1><p class="lede">A clearer picture of the way you move through the week.</p></div><button class="view-back" type="button" data-view="today">← Back to today</button></div><div class="pattern-grid"><article class="panel pattern-lead"><p class="eyebrow">Your rhythm</p><h2>Consistency is your superpower.</h2><p>Your most reliable window is between 7:35 and 7:50 AM, with Transit as your most predictable mode.</p><div class="pattern-bar"><span style="width: 78%"></span></div><small>78% of weekday trips start in your usual window</small></article><article class="panel metric-card"><p class="eyebrow">Usual departure</p><strong>7:42 <small>AM</small></strong><span>Most common weekday start</span></article><article class="panel metric-card"><p class="eyebrow">Average duration</p><strong>29 <small>min</small></strong><span>8 min faster than last week</span></article><article class="panel metric-card"><p class="eyebrow">Preferred mode</p><strong>${preferences.mode}</strong><span>Selected in your preferences</span></article><article class="panel metric-card"><p class="eyebrow">Fastest weekday</p><strong>Tuesday</strong><span>28 min average</span></article><article class="panel metric-card"><p class="eyebrow">Busiest weekday</p><strong>Thursday</strong><span>34 min average</span></article></div><article class="panel pattern-chart-panel"><div class="panel-heading"><div><p class="eyebrow">Weekly commute pattern</p><h2>Time across the week</h2></div><span class="insight-badge">4.8 / 5 accuracy</span></div><div class="pattern-chart"><span class="bar-label">40 min</span><i style="height: 56%"><b>Mon</b></i><i style="height: 46%"><b>Tue</b></i><i style="height: 62%"><b>Wed</b></i><i style="height: 77%"><b>Thu</b></i><i style="height: 50%"><b>Fri</b></i></div><div class="pattern-summary"><span><b>Common route</b>Green Line -> Red Line</span><span><b>Prediction accuracy</b>92% this month</span></div></article>`; };
  const renderHistory = () => { $('#history-view').innerHTML = `<div class="view-heading"><div><p class="eyebrow">Your journeys</p><h1 id="history-view-title">Trip history<span>.</span></h1><p class="lede">A simple record of recent sample trips.</p></div><button class="view-back" type="button" data-view="today">← Back to today</button></div><div class="history-list">${trips.map((trip, index) => `<button class="history-item" type="button" data-trip-index="${index}"><span class="history-date">${trip.date}</span><span class="history-route"><b>${trip.origin}</b><em>→</em><b>${trip.destination}</b></span><span class="history-mode">${trip.mode}</span><strong>${trip.duration} min</strong><span class="history-status ${trip.status === 'Delayed' ? 'delayed' : ''}">${trip.status}</span><span class="history-arrow">→</span></button>`).join('')}</div>`; };
  const switchView = (view) => { $$('.welcome-row, .forecast-grid, .lower-grid').forEach((section) => { section.hidden = view !== 'today'; }); $('#patterns-view').hidden = view !== 'patterns'; $('#history-view').hidden = view !== 'history'; $$('.nav-links a').forEach((link) => { const active = link.dataset.view === view; link.classList.toggle('active', active); if (active) link.setAttribute('aria-current', 'page'); else link.removeAttribute('aria-current'); }); if (view === 'patterns') renderPatterns(); if (view === 'history') renderHistory(); closePopovers(); window.scrollTo({ top: 0, behavior: 'smooth' }); };
  const updateRoute = (mode, notify = false) => { selectedMode = routes[mode] ? mode : 'Transit'; const route = routes[selectedMode]; saveStorage(storageKeys.route, { ...readStorage(storageKeys.route, {}), mode: selectedMode }); $$('.route-option').forEach((option) => option.classList.toggle('selected', option.dataset.mode === selectedMode)); const time = formatTime(preferences.time).split(' '); $('.hero-card h2 strong').textContent = time[0]; $('.hero-card h2 small').textContent = time[1]; $('.hero-copy').innerHTML = `${route.detail} <strong>${preferences.avoidTolls && selectedMode === 'Drive' ? 'Tolls avoided where possible.' : 'A comfortable fit for your routine.'}</strong>`; $('.route-track em').textContent = `${route.time} min`; $('[data-route-mode]').textContent = selectedMode; $('[data-route-time]').textContent = route.time; $('[data-route-departure]').textContent = formatTime(preferences.time); $('[data-route-summary]').textContent = route.route; $('[data-route-condition]').textContent = route.condition; if (notify) showToast(`${selectedMode} is now your selected route.`); };
  const loadPreferences = () => { $('#preferred-mode').value = preferences.mode; $('#preferred-time').value = preferences.time; $('#avoid-tolls').checked = preferences.avoidTolls; $('#notification-preference').value = preferences.notifications; $('[data-profile-mode]').textContent = preferences.mode; };
  const saveRoute = () => { saveStorage(storageKeys.route, { mode: selectedMode, savedAt: Date.now() }); $('.view-route-button').classList.add('is-saved'); showToast(`${selectedMode} route saved on this device.`); };

  renderPatterns(); renderHistory(); loadPreferences(); updateRoute(selectedMode); $$('.nav-links a').forEach((link) => { link.dataset.view = link.textContent === 'My patterns' ? 'patterns' : link.textContent === 'Trip history' ? 'history' : 'today'; });
  $$('.nav-links a').forEach((link) => link.addEventListener('click', (event) => { event.preventDefault(); switchView(link.dataset.view); })); $('.brand').addEventListener('click', (event) => { event.preventDefault(); switchView('today'); });
  $('.profile-button').addEventListener('click', (event) => { event.stopPropagation(); setPopover($('#profile-menu'), $('.profile-button'), $('#profile-menu').hidden); }); $('.icon-button').addEventListener('click', (event) => { event.stopPropagation(); setPopover($('#route-menu'), $('.icon-button'), $('#route-menu').hidden); });
  document.addEventListener('click', (event) => { if (!event.target.closest('.profile-wrap, .menu-wrap')) closePopovers(); if (event.target.matches('.modal-backdrop')) closeModal(event.target); const viewButton = event.target.closest('[data-view]'); if (viewButton) switchView(viewButton.dataset.view); const tripButton = event.target.closest('[data-trip-index]'); if (tripButton) { const trip = trips[tripButton.dataset.tripIndex]; $('[data-trip-detail]').innerHTML = `<b>${trip.date}</b><span>${trip.origin} → ${trip.destination} · ${trip.mode} · ${trip.duration} min</span><small>${trip.traffic}. ${trip.notes}</small>`; openModal('trip-modal'); } });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { closePopovers(); $$('.modal-backdrop:not([hidden])').forEach(closeModal); } }); $$('.route-option').forEach((option) => option.addEventListener('click', () => updateRoute(option.dataset.mode, true)));
  $('.view-route-button').addEventListener('click', () => { $('[data-route-saved]').textContent = readStorage(storageKeys.route, {}).savedAt ? 'Saved on this device' : ''; openModal('route-modal'); }); $$('[data-open-preferences]').forEach((button) => button.addEventListener('click', () => { loadPreferences(); openModal('preferences-modal'); })); $('[data-open-profile]').addEventListener('click', () => openModal('profile-modal')); $('[data-demo-signout]').addEventListener('click', () => { showToast('Sign out is unavailable in this frontend demo.'); closePopovers(); });
  $('[data-action="save-route"]').addEventListener('click', () => { saveRoute(); closePopovers(); }); $('[data-action="toggle-tolls"]').addEventListener('click', () => { preferences.avoidTolls = !preferences.avoidTolls; saveStorage(storageKeys.preferences, preferences); loadPreferences(); updateRoute(selectedMode); showToast(preferences.avoidTolls ? 'Avoid tolls enabled.' : 'Avoid tolls disabled.'); closePopovers(); });
  $('[data-action="share-route"]').addEventListener('click', async () => { const text = `${selectedMode} route: South End to Cambridge, ${routes[selectedMode].time} minutes via ${routes[selectedMode].route}.`; try { if (navigator.share) await navigator.share({ title: 'Wayfinder route', text }); else await navigator.clipboard.writeText(text); showToast(navigator.share ? 'Route share sheet opened.' : 'Route summary copied to clipboard.'); } catch { showToast('Sharing was cancelled.'); } closePopovers(); }); $('.save-route-button').addEventListener('click', saveRoute);
  $('.small-link').addEventListener('click', (event) => { event.preventDefault(); switchView('history'); }); $('.insight-card a').addEventListener('click', (event) => { event.preventDefault(); switchView('patterns'); }); $$('.modal-close, .cancel-button').forEach((button) => button.addEventListener('click', () => closeModal(button.closest('.modal-backdrop'))));
  $('#preferences-form').addEventListener('submit', (event) => { event.preventDefault(); preferences = { mode: $('#preferred-mode').value, time: $('#preferred-time').value, avoidTolls: $('#avoid-tolls').checked, notifications: $('#notification-preference').value }; saveStorage(storageKeys.preferences, preferences); updateRoute(preferences.mode); loadPreferences(); renderPatterns(); closeModal($('#preferences-modal')); showToast('Preferences saved on this device.'); });
  $('#forecast-date').addEventListener('change', () => { if (!$('#forecast-date').value) return; const date = new Date(`${$('#forecast-date').value}T12:00:00`); const dateText = formatDate(date); $('#date-label').textContent = dateText; $('.welcome-row .eyebrow').firstChild.textContent = dateText; $('#welcome-title').innerHTML = `${date.getDay() === 0 || date.getDay() === 6 ? 'Enjoy your day' : 'Good morning, Jordan'}<span>.</span>`; $('.hero-copy').innerHTML = `${routes[selectedMode].detail} <strong>Sample forecast for this date.</strong>`; showToast(`Showing sample forecast for ${dateText}.`); });
});
