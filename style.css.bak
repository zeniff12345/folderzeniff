:root { --ink: #17201d; --muted: #74807a; --line: #dfe5df; --paper: #f7f9f5; --white: #fff; --green: #275d4c; --mint: #dceee1; --coral: #ee8e6d; --yellow: #f6c96a; }
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: var(--paper); color: var(--ink); font-family: Manrope, sans-serif; }
body::before { content: ""; position: fixed; inset: 0; pointer-events: none; opacity: .28; background-image: radial-gradient(#c8d2ca .7px, transparent .7px); background-size: 18px 18px; }
.page-shell { position: relative; max-width: 1240px; margin: auto; padding: 0 42px 26px; }
.topbar { height: 92px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; }
.brand { display: flex; align-items: center; gap: 10px; color: var(--ink); font-size: 17px; font-weight: 800; letter-spacing: -.04em; text-decoration: none; }
.brand-mark { display: flex; align-items: end; gap: 3px; height: 21px; width: 20px; transform: skew(-16deg); }.brand-mark span { display: block; width: 4px; background: var(--coral); border-radius: 2px; }.brand-mark span:nth-child(1) { height: 10px; }.brand-mark span:nth-child(2) { height: 16px; background: var(--yellow); }.brand-mark span:nth-child(3) { height: 21px; background: var(--green); }
.nav-links { display: flex; gap: 35px; margin-left: 115px; }.nav-links a { color: var(--muted); font-size: 12px; font-weight: 700; text-decoration: none; }.nav-links a.active, .nav-links a:hover { color: var(--ink); }
.profile-button, .date-control, button { font-family: inherit; }.profile-button { display: flex; align-items: center; gap: 9px; border: 0; background: none; color: var(--ink); font-size: 12px; font-weight: 700; cursor: pointer; }.profile-button span { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--green); color: white; font: 10px "DM Mono", monospace; }.profile-button i { font-style: normal; color: var(--muted); margin-left: 3px; }
.welcome-row { display: flex; justify-content: space-between; align-items: end; padding: 68px 0 46px; }.eyebrow { color: var(--muted); font: 10px "DM Mono", monospace; letter-spacing: .11em; text-transform: uppercase; margin: 0 0 13px; }.status-dot { display: inline-block; background: #64a67e; width: 6px; height: 6px; border-radius: 50%; margin: 0 0 1px 7px; }.welcome-row h1 { font-size: clamp(35px, 5vw, 60px); letter-spacing: -.075em; line-height: .98; margin: 0; font-weight: 700; }.welcome-row h1 span { color: var(--coral); }.lede { color: var(--muted); font-size: 15px; margin: 17px 0 0; }.date-control { border: 1px solid var(--line); padding: 12px 15px; min-width: 132px; display: flex; gap: 10px; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; background: rgba(255,255,255,.55); }.calendar-icon { font-size: 16px; line-height: 10px; color: var(--green); }.chevron { color: var(--muted); margin-left: 5px; }
.forecast-grid { display: grid; grid-template-columns: 1.5fr .75fr .75fr; gap: 15px; }.hero-card { min-height: 348px; padding: 30px; color: white; background: var(--green); position: relative; overflow: hidden; }.hero-card::after { content: ""; position: absolute; width: 300px; height: 300px; border: 1px solid rgba(255,255,255,.12); border-radius: 50%; right: -90px; bottom: -150px; }.card-heading, .side-title, .panel-heading { display: flex; justify-content: space-between; align-items: start; }.eyebrow.light { color: #a9c5b8; }.hero-card h2 { margin: 0; font-size: 34px; font-weight: 500; letter-spacing: -.065em; }.hero-card h2 strong { font-weight: 800; }.hero-card h2 small { font: 12px "DM Mono", monospace; margin-left: 5px; color: #aed0bd; }.spark-icon { color: var(--yellow); font-size: 20px; }.hero-copy { max-width: 290px; color: #b8d0c4; font-size: 12px; line-height: 1.6; margin: 20px 0 35px; }.hero-copy strong { color: white; }.journey-line { display: flex; align-items: center; gap: 13px; }.line-start, .line-end { display: grid; grid-template-columns: 24px auto; column-gap: 6px; min-width: 72px; }.line-start small, .line-end small { grid-column: 2; color: #9fbbb0; font-size: 9px; margin-top: 2px; }.line-start b, .line-end b { font-size: 11px; }.pin { grid-row: span 2; display: grid; place-items: center; width: 23px; height: 23px; border-radius: 50%; background: #3c715e; color: #bfe1ce; font-size: 12px; }.work-pin { background: #e98b69; color: white; }.route-track { height: 1px; background: #6a9582; flex: 1; position: relative; }.route-track span { position: absolute; left: 47%; top: -3px; width: 7px; height: 7px; background: var(--yellow); border-radius: 50%; }.route-track em { position: absolute; left: 42%; top: 10px; font: 10px "DM Mono", monospace; color: #b8d0c4; font-style: normal; }.hero-footer { border-top: 1px solid #477765; position: absolute; bottom: 0; left: 30px; right: 30px; height: 56px; display: flex; align-items: center; gap: 23px; font: 10px "DM Mono", monospace; color: #c0d7c9; }.hero-footer i { font-style: normal; font-size: 15px; color: var(--yellow); vertical-align: -1px; }.hero-footer .traffic-icon { color: #a8d5a8; }.hero-footer button { margin-left: auto; border: 0; background: none; color: white; font-size: 11px; font-weight: 700; cursor: pointer; }.hero-footer button span, .text-button span, .small-link span, .insight-card a span { color: var(--coral); font-size: 17px; margin-left: 6px; }
.side-card { min-height: 348px; padding: 28px 24px; background: white; border: 1px solid var(--line); }.side-title span { color: #9aa49e; font: 9px "DM Mono", monospace; }.weather-reading { display: flex; align-items: center; gap: 17px; margin: 47px 0 45px; }.weather-icon { color: var(--yellow); font-size: 57px; font-family: serif; }.weather-reading strong { font-size: 38px; letter-spacing: -.08em; }.weather-reading p { color: var(--muted); font-size: 11px; margin: 2px 0; }.weather-range { border-top: 1px solid var(--line); padding-top: 15px; display: flex; justify-content: space-between; font: 9px "DM Mono", monospace; color: var(--muted); }.weather-range b { display: block; color: var(--ink); font-weight: 500; margin-top: 6px; }.insight-badge { padding: 5px 7px; background: var(--mint); color: var(--green) !important; }.insight-card h3 { max-width: 190px; font-size: 24px; line-height: 1.1; letter-spacing: -.06em; margin: 53px 0 13px; }.insight-card > p { color: var(--muted); font-size: 11px; line-height: 1.65; max-width: 205px; margin: 0 0 32px; }.insight-card a, .small-link { color: var(--green); font-size: 10px; font-weight: 800; text-decoration: none; }
.lower-grid { display: grid; grid-template-columns: 1fr 1.13fr; gap: 15px; margin-top: 15px; }.panel { background: white; border: 1px solid var(--line); padding: 28px 30px; }.panel h2 { font-size: 21px; letter-spacing: -.06em; margin: 0; }.icon-button { border: 0; background: none; color: var(--muted); letter-spacing: 2px; cursor: pointer; }.route-option { display: flex; align-items: center; gap: 13px; border-bottom: 1px solid var(--line); padding: 17px 0; }.route-option.selected { border-left: 3px solid var(--coral); padding-left: 12px; margin-left: -15px; }.mode-icon { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; color: var(--green); background: var(--mint); font-size: 13px; }.mode-icon.walk { color: #a9673f; background: #f9e7d4; }.mode-icon.bike { color: #718251; background: #eef2d7; }.option-copy { flex: 1; display: grid; gap: 4px; }.option-copy b { font-size: 11px; }.option-copy small, .option-meta { color: var(--muted); font: 9px "DM Mono", monospace; }.route-option > strong { font: 13px "DM Mono", monospace; }.option-tag { color: var(--green); background: var(--mint); padding: 5px 7px; font: 8px "DM Mono", monospace; }.text-button { border: 0; background: none; color: var(--green); font-size: 10px; font-weight: 800; padding: 18px 0 0; cursor: pointer; }.chart-grid { height: 130px; position: relative; margin-top: 30px; }.chart-grid span { display: block; border-top: 1px dashed #e4e9e4; position: relative; top: 32px; margin-bottom: 30px; }.chart-grid span:last-child { display: none; }.mini-chart svg { position: absolute; height: 130px; width: calc(100% - 60px); margin-top: -130px; overflow: visible; }.chart-line { fill: none; stroke: var(--coral); stroke-width: 3; }.chart-fill { fill: #fff3ec; }.mini-chart circle { fill: white; stroke: var(--coral); stroke-width: 2; }.chart-labels { display: flex; justify-content: space-between; color: var(--muted); font: 9px "DM Mono", monospace; padding: 3px 4px 0; }.history-stat { display: flex; gap: 35px; border-top: 1px solid var(--line); margin-top: 21px; padding-top: 17px; }.history-stat div { display: grid; gap: 4px; }.history-stat strong { font: 22px "DM Mono", monospace; }.history-stat strong small { font-size: 10px; color: var(--muted); }.history-stat strong.green { color: var(--green); }.history-stat span { color: var(--muted); font: 9px "DM Mono", monospace; }
footer { display: flex; justify-content: space-between; color: #9ba69f; font: 9px "DM Mono", monospace; padding: 26px 0 0; }footer b { color: var(--coral); margin: 0 5px; }footer i { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #6eae86; margin-left: 5px; }
@media (max-width: 800px) { .page-shell { padding: 0 20px 22px; }.topbar { height: 76px; }.nav-links { display: none; }.profile-button b, .profile-button i { display: none; }.welcome-row { padding: 47px 0 32px; align-items: start; gap: 20px; flex-direction: column; }.date-control { align-self: stretch; }.forecast-grid, .lower-grid { grid-template-columns: 1fr; }.hero-card, .side-card { min-height: 320px; }.insight-card h3 { margin-top: 45px; }.panel { padding: 25px 21px; }.route-option.selected { margin-left: -10px; padding-left: 8px; }.history-stat { gap: 17px; justify-content: space-between; }.history-stat strong { font-size: 17px; }footer { gap: 14px; flex-direction: column; } }
@media (max-width: 420px) { .hero-card { padding: 24px 20px; }.hero-card h2 { font-size: 30px; }.hero-footer { left: 20px; right: 20px; gap: 10px; }.hero-footer span { font-size: 8px; }.hero-footer button { font-size: 9px; }.journey-line { gap: 7px; }.line-start, .line-end { min-width: 63px; }.option-meta { display: none; } }

/* Interactive states and lightweight frontend overlays. */
.profile-wrap, .menu-wrap { position: relative; }
.popover { position: absolute; z-index: 10; min-width: 150px; padding: 6px; background: var(--white); border: 1px solid var(--line); box-shadow: 0 12px 28px rgba(23, 32, 29, .1); animation: pop-in .16s ease-out; }
.profile-menu { top: calc(100% + 12px); right: 0; }
.route-menu { top: calc(100% + 9px); right: 0; }
.popover button { display: block; width: 100%; padding: 10px 11px; border: 0; background: transparent; color: var(--ink); text-align: left; font-size: 11px; cursor: pointer; }
.popover button:hover, .popover button:focus-visible { background: var(--mint); color: var(--green); outline: 0; }
.date-control { position: relative; cursor: pointer; }
.date-control input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
.route-option { width: 100%; border: 0; border-bottom: 1px solid var(--line); outline: 0; box-shadow: none; background: var(--white); color: var(--ink); text-align: left; font-family: inherit; cursor: pointer; appearance: none; -webkit-appearance: none; transition: background .2s ease, border-color .2s ease; }
.route-option:hover { background: #fbfcfa; }
.route-option:focus-visible, .profile-button:focus-visible, .icon-button:focus-visible, .text-button:focus-visible, .hero-footer button:focus-visible, .date-control:focus-within { outline: 2px solid var(--coral); outline-offset: 3px; }
.hero-footer button { border: 0; background: none; color: var(--yellow); font: 800 10px Manrope, sans-serif; cursor: pointer; margin-left: auto; }
.modal-backdrop[hidden], .popover[hidden] { display: none; }
.modal-backdrop { position: fixed; z-index: 20; inset: 0; display: grid; place-items: center; padding: 20px; background: rgba(23, 32, 29, .42); animation: fade-in .18s ease-out; }
.modal { position: relative; width: min(100%, 450px); max-height: calc(100vh - 40px); overflow: auto; padding: 32px; background: var(--paper); border: 1px solid var(--line); box-shadow: 0 20px 50px rgba(23, 32, 29, .2); animation: modal-in .2s ease-out; }
.modal h2 { margin: 0 0 26px; font-size: 29px; letter-spacing: -.06em; }
.modal-close { position: absolute; top: 17px; right: 20px; border: 0; background: none; color: var(--muted); font-size: 25px; line-height: 1; cursor: pointer; }
.modal-close:hover { color: var(--ink); }
.modal-route { display: flex; align-items: center; gap: 9px; padding: 17px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.modal-route div { display: grid; gap: 3px; }.modal-route b { font-size: 11px; }.modal-route small { color: var(--muted); font: 9px "DM Mono", monospace; }.modal-arrow { flex: 1; color: var(--coral); text-align: center; }
.detail-list { display: grid; gap: 0; margin: 6px 0 0; }.detail-list div { display: flex; justify-content: space-between; padding: 13px 0; border-bottom: 1px solid var(--line); }.detail-list dt { color: var(--muted); font: 9px "DM Mono", monospace; text-transform: uppercase; }.detail-list dd { margin: 0; font-size: 11px; font-weight: 800; }
#preferences-form { display: grid; gap: 18px; }.modal label { display: grid; gap: 8px; color: var(--muted); font: 9px "DM Mono", monospace; text-transform: uppercase; }.modal select, .modal input[type="time"] { width: 100%; padding: 12px; border: 1px solid var(--line); background: var(--white); color: var(--ink); font: 11px Manrope, sans-serif; }.checkbox-label { display: flex !important; grid-template-columns: 16px auto; align-items: center; gap: 8px !important; text-transform: none !important; }.checkbox-label input { accent-color: var(--green); }.form-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 9px; }.form-actions button { padding: 11px 14px; border: 1px solid var(--green); font: 700 10px Manrope, sans-serif; cursor: pointer; }.cancel-button { background: transparent; color: var(--green); }.save-button { background: var(--green); color: var(--white); }.form-actions button:focus-visible { outline: 2px solid var(--coral); outline-offset: 2px; }
.trip-detail { display: grid; gap: 6px; padding: 15px 0; border-bottom: 1px solid var(--line); }.trip-detail b { font-size: 12px; }.trip-detail span, .trip-detail small { color: var(--muted); font: 10px/1.5 "DM Mono", monospace; }.toast { position: fixed; z-index: 30; right: 28px; bottom: 25px; max-width: min(340px, calc(100vw - 40px)); padding: 13px 16px; background: var(--ink); color: var(--white); font: 10px/1.4 "DM Mono", monospace; opacity: 0; transform: translateY(10px); pointer-events: none; transition: opacity .2s ease, transform .2s ease; }.toast.visible { opacity: 1; transform: translateY(0); }
body.modal-open { overflow: hidden; }
.hero-card::after { pointer-events: none; }
.app-view[hidden], .welcome-row[hidden], .forecast-grid[hidden], .lower-grid[hidden] { display: none; }
.view-heading { display: flex; align-items: end; justify-content: space-between; padding: 68px 0 46px; }.view-heading h1 { margin: 0; font-size: clamp(35px, 5vw, 60px); letter-spacing: -.075em; line-height: .98; }.view-heading h1 span { color: var(--coral); }.view-back { border: 1px solid var(--line); padding: 12px 15px; background: rgba(255,255,255,.55); color: var(--green); font: 700 10px Manrope, sans-serif; cursor: pointer; }.view-back:hover { background: var(--mint); }
.pattern-grid { display: grid; grid-template-columns: 1.5fr repeat(2, 1fr); gap: 15px; }.pattern-lead { grid-row: span 2; min-height: 250px; }.pattern-lead h2 { max-width: 280px; margin: 36px 0 14px; font-size: 27px; line-height: 1.05; }.pattern-lead p:not(.eyebrow) { max-width: 300px; color: var(--muted); font-size: 11px; line-height: 1.6; }.pattern-lead small, .metric-card span { color: var(--muted); font: 9px "DM Mono", monospace; }.pattern-bar { height: 5px; margin: 32px 0 10px; background: var(--mint); }.pattern-bar span { display: block; height: 100%; background: var(--coral); }.metric-card { min-height: 116px; padding: 22px; }.metric-card strong { display: block; margin: 22px 0 7px; font-size: 23px; letter-spacing: -.06em; }.metric-card strong small { color: var(--muted); font: 10px "DM Mono", monospace; }.pattern-chart-panel { margin-top: 15px; }.pattern-chart { display: flex; align-items: end; gap: 11%; height: 190px; margin-top: 29px; padding: 0 20px 25px; border-bottom: 1px solid var(--line); position: relative; }.pattern-chart::before { content: ""; position: absolute; inset: 0 0 25px; background: repeating-linear-gradient(to bottom, transparent 0 44px, #e8ece8 45px); pointer-events: none; }.pattern-chart i { position: relative; z-index: 1; display: block; width: 10%; min-height: 35px; background: var(--green); font-style: normal; }.pattern-chart i:nth-of-type(2), .pattern-chart i:nth-of-type(5) { background: var(--coral); }.pattern-chart b { position: absolute; bottom: -21px; left: 50%; transform: translateX(-50%); color: var(--muted); font: 9px "DM Mono", monospace; font-weight: 400; }.bar-label { position: absolute; top: -17px; left: 0; color: var(--muted); font: 9px "DM Mono", monospace; }.pattern-summary { display: flex; gap: 50px; padding-top: 21px; color: var(--muted); font: 10px "DM Mono", monospace; }.pattern-summary span { display: grid; gap: 6px; }.pattern-summary b { color: var(--ink); font: 700 10px Manrope, sans-serif; }.history-list { border-top: 1px solid var(--line); }.history-item { display: grid; grid-template-columns: 1.2fr 1.6fr .7fr .5fr .7fr 20px; align-items: center; gap: 15px; width: 100%; padding: 19px 10px; border: 0; border-bottom: 1px solid var(--line); background: rgba(255,255,255,.8); color: var(--ink); text-align: left; cursor: pointer; transition: background .2s ease, padding .2s ease; }.history-item:hover, .history-item:focus-visible { padding-left: 15px; background: var(--mint); outline: 0; }.history-date, .history-mode, .history-status { color: var(--muted); font: 9px "DM Mono", monospace; }.history-route { display: flex; align-items: center; gap: 8px; font-size: 11px; }.history-route em { color: var(--coral); font-style: normal; }.history-item > strong { font: 13px "DM Mono", monospace; }.history-status { color: var(--green); }.history-status.delayed { color: #a9673f; }.history-arrow { color: var(--coral); font-size: 17px; }.profile-summary { display: flex; align-items: center; gap: 13px; padding: 10px 0 20px; border-bottom: 1px solid var(--line); }.profile-summary > span { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: var(--green); color: var(--white); font: 11px "DM Mono", monospace; }.profile-summary div { display: grid; gap: 5px; }.profile-summary b { font-size: 12px; }.profile-summary small, .saved-note { color: var(--muted); font: 9px "DM Mono", monospace; }.save-route-button { margin-top: 20px; }.saved-note { margin-left: 10px; color: var(--green); }.view-route-button.is-saved { color: var(--white); }.view-route-button.is-saved::before { content: "✓ "; }
@keyframes pop-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes modal-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
@media (max-width: 420px) { .popover { min-width: 135px; }.modal { padding: 27px 21px; }.toast { right: 20px; bottom: 20px; } }
@media (max-width: 800px) { .view-heading { padding: 47px 0 32px; align-items: start; gap: 22px; flex-direction: column; }.pattern-grid { grid-template-columns: 1fr 1fr; }.pattern-lead { grid-column: span 2; grid-row: auto; }.history-item { grid-template-columns: 1fr auto auto; gap: 8px 12px; }.history-date, .history-route { grid-column: span 3; }.history-mode { grid-column: 1; }.history-item > strong { grid-column: 2; }.history-status { grid-column: 3; }.history-arrow { display: none; } }
@media (max-width: 420px) { .pattern-grid { grid-template-columns: 1fr; }.pattern-lead { grid-column: auto; }.pattern-summary { gap: 20px; flex-direction: column; }.pattern-chart { gap: 7%; padding-left: 10px; padding-right: 10px; }.view-back { align-self: stretch; }.history-item { padding-left: 0; padding-right: 0; }.history-item:hover, .history-item:focus-visible { padding-left: 5px; } }
@media (max-width: 800px) { .topbar { height: auto; min-height: 76px; flex-wrap: wrap; padding-top: 14px; row-gap: 14px; }.nav-links { display: flex; order: 3; width: 100%; margin-left: 0; padding-bottom: 12px; justify-content: space-between; gap: 12px; }.nav-links a { font-size: 10px; } }